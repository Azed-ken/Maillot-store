# --- Supabase (public, exposées au navigateur) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Supabase (privée, JAMAIS exposée au client) ---
# Utilisée uniquement côté serveur (server actions / route handlers admin)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Boutique (valeurs de secours si "store_settings" est vide) ---
NEXT_PUBLIC_DEFAULT_WHATSAPP_NUMBER=22900000000
NEXT_PUBLIC_DEFAULT_STORE_NAME=Maillot Store
